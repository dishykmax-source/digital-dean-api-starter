          ],
          "path": [
            "api",
            "v1",
            "students",
            "{{student_id}}",
            "secure-notes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"     \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"422\",()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Reject unknown field key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "students",
            "{{student_id}}",
            "secure-notes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"ok\",\n  \"key\": \"00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"422\",()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Note via another student",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/students/{{student_b_id}}/secure-notes/{{note_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "students",
            "{{student_b_id}}",
            "secure-notes",
            "{{note_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"404 and no text\",()=>{",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.json()).not.to.have.property(\"text\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Benchmark results",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/lab/crypto/benchmark-results",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "lab",
            "crypto",
            "benchmark-results"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"report ok\",()=>{",
              "  pm.response.to.have.status(200);",
              "  const b=pm.response.json();",
              "  pm.expect(b.schema_version).to.eql(1);",
              "  pm.expect(b.results.length).to.eql(36);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09a Get student (regression)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/students/{{student_id}}",
          "host": [
