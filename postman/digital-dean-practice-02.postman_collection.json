{
  "info": {
    "name": "Digital Dean — Practice 02",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"ok\",()=>pm.expect(pm.response.json()).to.eql({status:\"ok\"}));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create student A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/students",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "students"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Іван Петренко\",\n  \"email\": \"student{{$timestamp}}a@example.com\",\n  \"group_code\": \"КН-31\",\n  \"academic_status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201\",()=>pm.response.to.have.status(201));",
              "const b=pm.response.json();",
              "pm.expect(b.id).to.be.a(\"string\");",
              "pm.collectionVariables.set(\"student_id\",b.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02b Create student B",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/students",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "students"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Іван Петренко\",\n  \"email\": \"student{{$timestamp}}b@example.com\",\n  \"group_code\": \"КН-31\",\n  \"academic_status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201\",()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"student_b_id\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create secure note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "students",
            "{{student_id}}",
            "secure-notes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Навчальна примітка про погодження індивідуального плану\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"note created\",()=>{",
              "  pm.response.to.have.status(201);",
              "  const body=pm.response.json();",
              "  pm.expect(body.id).to.be.a(\"string\");",
              "  pm.expect(body.student_id).to.eql(pm.collectionVariables.get(\"student_id\"));",
              "  pm.expect(body).not.to.have.property(\"text\");",
              "  pm.expect(body).not.to.have.property(\"key\");",
              "  pm.collectionVariables.set(\"note_id\",body.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Get secure note",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes/{{note_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "students",
            "{{student_id}}",
            "secure-notes",
            "{{note_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"exact text\",()=>{",
              "  pm.response.to.have.status(200);",
              "  const b=pm.response.json();",
              "  pm.expect(b.text).to.eql(\"Навчальна примітка про погодження індивідуального плану\");",
              "  pm.expect(b.id).to.eql(pm.collectionVariables.get(\"note_id\"));",
              "  pm.expect(b.student_id).to.eql(pm.collectionVariables.get(\"student_id\"));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Reject whitespace-only text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes",
          "host": [
