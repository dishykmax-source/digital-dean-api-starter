          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"group_code\": \"КН-32\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"changed\",()=>pm.expect(pm.response.json().group_code).to.eql(\"КН-32\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 List notes metadata (variant 3)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "students",
            "{{student_id}}",
            "secure-notes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"metadata only\",()=>{",
              "  pm.response.to.have.status(200);",
              "  const list=pm.response.json();",
              "  pm.expect(list).to.be.an(\"array\").that.is.not.empty;",
              "  list.forEach(i=>{",
              "    pm.expect(Object.keys(i).sort()).to.eql([\"algorithm\",\"id\",\"student_id\"]);",
              "    pm.expect(i.student_id).to.eql(pm.collectionVariables.get(\"student_id\"));",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
