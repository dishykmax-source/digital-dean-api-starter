            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"academic_status kept\",()=>pm.expect(pm.response.json().academic_status).to.eql(\"active\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "09b Patch student (regression)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/students/{{student_id}}",
          "host": [
