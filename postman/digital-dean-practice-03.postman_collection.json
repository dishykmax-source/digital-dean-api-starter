  "item": [{"name":"Asymmetric benchmark results — summary variant 3", "request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/v1/lab/crypto/asymmetric-benchmark-results","host":["{{baseUrl}}"],"path":["api","v1","lab","crypto","asymmetric-benchmark-results"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('HTTP 200', () => pm.response.to.have.status(200));","pm.test('summary is present', () => pm.expect(pm.response.json().summary).to.have.keys('key_profiles_count','results_count','checks_count','all_checks_passed'));","pm.test('five key profiles', () => pm.expect(pm.response.json().summary.key_profiles_count).to.eql(5));","pm.test('22 result rows and checks', () => { const s=pm.response.json().summary; pm.expect(s.results_count).to.eql(22); pm.expect(s.checks_count).to.eql(22); });"]}}}]}
