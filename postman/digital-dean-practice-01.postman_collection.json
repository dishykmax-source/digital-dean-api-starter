{
  "info": {
    "name": "Digital Dean API — Practice 01 (Variant 3)",
    "description": "Послідовна перевірка контракту API. Запустіть локальний сервер і встановіть base_url = http://127.0.0.1:8000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "student_id", "value": "" }
  ],
  "item": [
    { "name": "1. Health", "request": { "method": "GET", "url": "{{base_url}}/health" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('health body', () => pm.expect(pm.response.json()).to.eql({status: 'ok'}));"] } }] },
    { "name": "2. Create student", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Олена Коваль\",\n  \"email\": \"olena.koval@example.com\",\n  \"group_code\": \"КН-31\",\n  \"academic_status\": \"active\"\n}" }, "url": "{{base_url}}/api/v1/students" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.test('response has id and variant field', () => { pm.expect(body.id).to.be.a('string'); pm.expect(body.academic_status).to.eql('active'); });", "pm.collectionVariables.set('student_id', body.id);"] } }] },
    { "name": "3. List students", "request": { "method": "GET", "url": "{{base_url}}/api/v1/students" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200 and array', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"] } }] },
    { "name": "4. Get student", "request": { "method": "GET", "url": "{{base_url}}/api/v1/students/{{student_id}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200 and matching id', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('student_id')); });"] } }] },
    { "name": "5. Get missing student", "request": { "method": "GET", "url": "{{base_url}}/api/v1/students/00000000-0000-0000-0000-000000000001" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 404', () => pm.response.to.have.status(404));"] } }] },
    { "name": "6. PATCH academic status", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"academic_status\": \"academic_leave\"\n}" }, "url": "{{base_url}}/api/v1/students/{{student_id}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200 and status updated', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().academic_status).to.eql('academic_leave'); });"] } }] },
    { "name": "7. Invalid email", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Тест Студент\",\n  \"email\": \"bad-email\",\n  \"group_code\": \"КН-31\",\n  \"academic_status\": \"active\"\n}" }, "url": "{{base_url}}/api/v1/students" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 422', () => pm.response.to.have.status(422));"] } }] },
    { "name": "8. Unknown PATCH field", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"is_admin\": true\n}" }, "url": "{{base_url}}/api/v1/students/{{student_id}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 422', () => pm.response.to.have.status(422));"] } }] },
    { "name": "9. Filter by academic_status", "request": { "method": "GET", "url": "{{base_url}}/api/v1/students?academic_status=academic_leave" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200 and all results filtered', () => { pm.response.to.have.status(200); pm.response.json().forEach(s => pm.expect(s.academic_status).to.eql('academic_leave')); });"] } }] },
    { "name": "10. Invalid academic_status", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Тест Студент\",\n  \"email\": \"variant@example.com\",\n  \"group_code\": \"КН-31\",\n  \"academic_status\": \"unknown_status\"\n}" }, "url": "{{base_url}}/api/v1/students" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 422 for unknown enum value', () => pm.response.to.have.status(422));"] } }] },
    { "name": "11. Duplicate email", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Інший Студент\",\n  \"email\": \"olena.koval@example.com\",\n  \"group_code\": \"КН-31\",\n  \"academic_status\": \"active\"\n}" }, "url": "{{base_url}}/api/v1/students" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 409', () => pm.response.to.have.status(409));"] } }] }
  ]
}
